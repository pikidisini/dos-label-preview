{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DOS Label Preview",
  "version": "3.0.0",
  "identifier": "com.fiqih.dos-label-preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DOS Label Preview & Studio (TAX / DAX)",
        "width": 1360,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
